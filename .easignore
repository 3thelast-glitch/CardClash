# This file must live at the Git repository root because EAS packages from there.
# Keep the tracked Expo project at CardClash/ and exclude only
# local dependencies, generated output, tests, and documentation.

# Repository-local editor and machine state
/.idea/
/.vscode/
/.expo/
/.git_disabled/

# Dependencies and package-manager caches at any repository level
**/node_modules/
**/.pnpm-store/
**/.yarn/
**/.npm/

# Expo, Metro, TypeScript, and generated build output
**/.expo/
**/.cache/
**/dist/
**/web-build/
**/android/
**/ios/
**/.kotlin/
**/*.tsbuildinfo
**/.metro-health-check*

# Tests, browser artefacts, editor history, and non-runtime documentation
/.github/
/CardClash/.history/
/CardClash/test-results/
/CardClash/playwright-report/
/CardClash/coverage/
/CardClash/tests/
/CardClash/reports/
/CardClash/docs/
/CardClash/design/

# Local secrets and signing materials
**/.env
**/.env.*
!**/.env.example
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.pem

# Logs, archives, and operating-system artefacts
**/npm-debug.*
**/yarn-debug.*
**/yarn-error.*
**/*.log
**/*.tgz
**/*.tar.gz
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db
